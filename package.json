{
  "name": "cdcf-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:api": "redocly lint --config .redocly.yaml",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#wordpress/**/vendor\" \"#.next\" \"#coverage\" \"#.claude\" \"#scripts/tests/bats\"",
    "lint:md:fix": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#wordpress/**/vendor\" \"#.next\" \"#coverage\" \"#.claude\" \"#scripts/tests/bats\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs}\" \"!node_modules/**\" \"!**/vendor/**\" \"!.next/**\" \"!coverage/**\" \"!.claude/**\" \"!scripts/tests/bats/**\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs}\" \"!node_modules/**\" \"!**/vendor/**\" \"!.next/**\" \"!coverage/**\" \"!.claude/**\" \"!scripts/tests/bats/**\"",
    "format:md": "prettier --write \"**/*.md\" \"!node_modules/**\" \"!**/vendor/**\" \"!.next/**\" \"!coverage/**\" \"!.claude/**\" \"!scripts/tests/bats/**\"",
    "format:md:check": "prettier --check \"**/*.md\" \"!node_modules/**\" \"!**/vendor/**\" \"!.next/**\" \"!coverage/**\" \"!.claude/**\" \"!scripts/tests/bats/**\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "clsx": "^2.1.1",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "striptags": "^3.2.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "happy-dom": "21.0.4",
    "markdownlint-cli2": "^0.24.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "katex": "^0.18.2",
    "postcss-selector-parser": "^6.1.5"
  }
}
